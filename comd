services:

  mysql:
    image: mysql:8.4
    container_name: mysql-db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: root9721
    ports:
      - "3306:3306"
    volumes:
      - mysql-data:/var/lib/mysql

  service-registry:
    build:
      context: ./one-day-worker-service-registry
    container_name: service-registry
    ports:
      - "8761:8761"

  api-gateway:
    build:
      context: ./one-day-worker-api-gateway
    container_name: api-gateway
    ports:
      - "8080:8080"

  user-service:
    build:
      context: ./one-day-worker-user
    container_name: user-service
    ports:
      - "8081:8081"

  worker-service:
    build:
      context: ./one-day-worker-worker
    container_name: worker-service
    ports:
      - "8083:8083"

  rating-service:
    build:
      context: ./one-day-worker-rating
    container_name: rating-service
    ports:
      - "8082:8082"

volumes:
  mysql-data: